---
import Layout from '../layouts/Layout.astro';
import TreatmentHero from '../components/treatment/TreatmentHero.astro';
import ProfileSelector from '../components/treatment/ProfileSelector.astro';
import SplitSection from '../components/treatment/SplitSection.astro';
import ScientificRigor from '../components/treatment/ScientificRigor.astro';
import WhyBarcelonaCards from '../components/treatment/WhyBarcelonaCards.astro';
import TreatmentProcess from '../components/treatment/TreatmentProcess.astro';
import ClinicalExperienceIVF from '../components/treatment/ClinicalExperienceIVF.astro';
import PlanningAbroad from '../components/treatment/PlanningAbroad.astro';
import FAQAccordion from '../components/treatment/FAQAccordion.astro';
import ValueEvaluation from '../components/treatment/ValueEvaluation.astro';
import PatientVoices from '../components/home/PatientVoices.astro';
import MedicalRecognition from '../components/home/MedicalRecognition.astro';
import LeadForm from '../components/home/LeadForm.astro';
import { fpRigorIcons } from '../data/fpRigorIcons';

const u = 'https://fivclinic.es/international-patients/wp-content/uploads/';

const profileCards = [
  { icon: u + '2026/04/Group-1088.svg', title: 'Postponing Motherhood', quote: '"I\u2019m not ready to be a mother right now, but I want to understand if preserving my fertility today will give me more realistic flexibility for the future."', cta: 'View the Age-Related Path' },
  { icon: u + '2026/04/Group-1091.svg', title: 'Medical Treatment', quote: '"I\u2019ve received a medical diagnosis, such as cancer, and I need to know my options for protecting my fertility before my treatment begins."', cta: 'View Medical Necessity Options' },
  { icon: u + '2026/04/Group-1094.svg', title: 'Specific Health Conditions', quote: '"I have a condition like endometriosis or a family history of early menopause, and I want to see if my fertility window is narrower than I think."', cta: 'View Health-Specific Guidance' },
  { icon: u + '2026/04/Group-1097.svg', title: 'Expert Assessment First', quote: '"I\u2019m not sure if egg freezing is right for me yet. I want a professional, data-driven assessment of my reserve before I make any decisions."', cta: 'View Assessment Details' },
];

const rigorItems = [
  { text: 'Fertility preservation begins with a personalised evaluation of ovarian reserve', icon: fpRigorIcons[0] },
  { text: 'Recommendations are based on age, ovarian markers, and reproductive context', icon: fpRigorIcons[1] },
  { text: 'Treatment is proposed only when it is viable and medically meaningful', icon: fpRigorIcons[2] },
  { text: 'The process is explained with realism, not promises', icon: fpRigorIcons[3] },
  { text: 'Clinical expertise is combined with respectful, individualised care throughout', icon: fpRigorIcons[4] },
];

const blocks = [
  {
    title: 'For women who want to postpone motherhood',
    intro: ['Egg freezing is most effective when considered before fertility begins to decline significantly. Ideally before 35, as egg quality and quantity tend to diminish more rapidly after 37.'],
    boxIntro: 'What we assess before any recommendation:',
    items: ['Current ovarian reserve through AMH and antral follicle count', 'Age and fertility trend', 'Overall medical context', 'Reproductive goals and timing'],
    closing: ['What matters is not acting out of fear, but understanding whether preserving fertility now may give you more flexibility later, and whether your current ovarian reserve makes that a meaningful option.'],
    image: u + '2026/04/fertility-preservation-fivclinic.png',
    imageSide: 'left',
  },
  {
    title: 'For patients facing medical treatment that may affect fertility',
    intro: ['For some women, fertility preservation is not elective. It becomes an important step before a treatment such as <strong>chemotherapy or radiotherapy</strong> that may compromise ovarian function.'],
    boxIntro: 'Depending on your situation, preservation options may include:',
    items: ['Oocyte cryopreservation', 'Embryo cryopreservation', 'Ovarian tissue preservation (when indicated)'],
    closing: ['In these cases, timing matters. A well-coordinated fertility assessment helps determine whether preservation should be completed before treatment begins.'],
    image: u + '2026/04/fertility-barcelona.png',
    imageSide: 'right',
  },
  {
    title: 'For women with conditions that may compromise fertility',
    intro: ['Certain gynaecological or medical conditions may reduce the fertility window more quickly than expected. Early assessment can make a significant difference in the options still available.'],
    boxIntro: 'We recommend evaluation if you have or are at risk of:',
    items: ['Endometriosis', 'Autoimmune diseases', 'Low ovarian reserve', 'Benign ovarian cysts', 'Risk of early menopause'],
    closing: ['This is not about assuming the worst. It is about understanding whether your current fertility window may be narrower than it appears, so acting while meaningful options still exist.'],
    image: u + '2026/04/Gemini_Generated_Image_ifbax9ifbax9ifba-1.png',
    imageSide: 'left',
  },
  {
    title: 'For women who want an expert ovarian reserve assessment before deciding',
    intro: ['Not every patient who asks about fertility preservation will be a good candidate for it. The right first step is often a careful, individualised assessment before any treatment decision is made.'],
    boxIntro: 'Ovarian reserve is assessed through:',
    items: ['Anti-M\u00fcllerian Hormone (AMH) blood testing', 'Antral follicle count on ultrasound', 'Full medical review to identify contraindications or clinically relevant factors'],
    closing: ['If reserve is already significantly compromised, the procedure may not be recommended. That is why the assessment always comes before the recommendation.'],
    image: u + '2026/04/fertility-experts-fivclinic.png',
    imageSide: 'right',
  },
];

const processSteps = [
  { icon: u + '2026/04/Group-1099.svg', title: 'Ovarian reserve assessment', text: 'We review your age, medical history, reproductive goals, and ovarian reserve markers to determine whether fertility preservation is a suitable option for you.' },
  { icon: u + '2026/04/Group-1079.svg', title: 'Individualised treatment planning', text: 'If the procedure is appropriate, we explain the recommended approach, expected timing, and what the process is likely to involve in your specific case.' },
  { icon: u + '2026/04/Group-769-1.svg', title: 'Ovarian stimulation and egg retrieval', text: 'The process involves hormonal stimulation to encourage the development of multiple follicles, generally over approximately two weeks, followed by egg retrieval once the follicles have reached the appropriate stage.' },
  { icon: u + '2026/04/Group-657-1.svg', title: 'Vitrification and future use', text: 'Once retrieved, the oocytes are vitrified and stored. If you later decide to pursue pregnancy, the eggs can be thawed and the process continues through IVF: fertilisation, embryo development, and embryo transfer.' },
];

const intlFaqs = [
  { q: 'Can the process begin before travelling to Barcelona?', a: 'Yes. The first step can begin with an expert consultation and fertility assessment, so you understand whether preservation is worth considering before organising travel.' },
  { q: 'How long does the process require in Barcelona?', a: 'Not a prolonged stay. The stimulation phase lasts approximately two weeks before retrieval, which means the treatment can generally be organised around a defined and plannable timeframe.' },
  { q: 'Can initial consultations be done online?', a: 'Yes. Initial consultations and ovarian reserve assessment planning can be carried out remotely, so you can receive specialist guidance before travelling.' },
  { q: 'Who will support me during treatment?', a: 'You will be supported by:', list: ['A reproductive medicine team specialised in fertility preservation', 'A patient coordinator experienced in international care pathways', 'English-speaking staff throughout your journey'], foot: 'You are never expected to navigate the process alone.' },
];

const realFaqs = [
  { q: 'When should fertility preservation be considered?', a: 'It may be considered when motherhood is likely to be postponed, before treatments that may damage fertility, or in the presence of conditions such as endometriosis, autoimmune disease, low ovarian reserve, ovarian cysts, or risk of early menopause.' },
  { q: 'What does the process involve?', a: 'It usually involves ovarian stimulation over approximately two weeks, followed by egg retrieval and vitrification. The specific protocol is adapted to your age, ovarian reserve, and medical context.' },
  { q: 'What is the best age to freeze eggs?', a: 'Egg freezing is ideally considered before age 35. Fertility decline becomes especially significant after 37, which is why early assessment, even before a firm decision is made, is often the most valuable first step.' },
  { q: 'Can fertility preservation be considered for medical reasons?', a: 'Yes. Preservation before treatments such as chemotherapy or radiotherapy, or in conditions that may impair fertility, is a clinically well-established indication, and one that requires careful coordination with the treating team.' },
  { q: 'Does egg freezing guarantee pregnancy in the future?', a: 'No. Vitrifying oocytes does not guarantee a future pregnancy. Not all eggs survive thawing or lead to viable embryos, which is why individualised assessment and realistic counselling are central to our approach.' },
  { q: 'What if my ovarian reserve is already low?', a: 'When ovarian reserve is already significantly compromised, the procedure may not be recommended. This is precisely why an individualised assessment is the right first step before any decision is made.' },
  { q: 'How do you assess whether I am a good candidate?', a: 'Ovarian reserve is evaluated primarily through AMH blood testing and antral follicle count on ultrasound, together with a full medical review. If reserve is already significantly compromised, the procedure may not be recommended.' },
  { q: 'Can I start the process if I live outside Barcelona or abroad?', a: 'Yes. The process can begin with a remote consultation and assessment planning before any trip is organised. Initial appointments can be held online.' },
];

const fpTestimonials = [
  { quote: 'I wanted to make a decision based on real information, not guesswork. That made all the difference.', author: 'Patient considering fertility preservation' },
  { quote: 'They explained the process with realism and sensitivity. I felt guided, not pressured.', author: 'Woman seeking early fertility assessment' },
  { quote: 'What I valued most was understanding my ovarian reserve and what it actually meant for my timing.', author: 'Patient exploring future fertility options' },
];
---

<Layout
  title="Egg Freezing & Fertility Preservation in Barcelona | FIVClínic"
  description="Fertility preservation in Barcelona — expert, individualized care to protect your future reproductive options, backed by Hospital Clínic Barcelona."
>
  <TreatmentHero
    titlePlain="in Barcelona"
    titleAccent="Fertility Preservation"
    lead="Expert, individualized care to help you protect your future reproductive options."
    paragraphs={[
      'The decision to preserve fertility rarely comes from the same place. Some women are planning ahead, making space for a future family while other areas of life are still taking shape. Others face a medical situation that makes the question urgent, and the timing less of a choice.',
      'Wherever you are in that process, our role at <strong>FIVClínic</strong> is to help you understand your options, evaluate whether preservation is genuinely right for you, and feel supported by a team that combines clinical expertise with human care.',
      '<em>Through our integration with barnaclínic+, the private medicine programme of Hospital Clínic Barcelona, our patients benefit from the clinical environment of one of Europe\u2019s most respected university hospitals.</em>',
    ]}
    note="FIVClínic is the assisted reproduction department of barnaclínic+, backed by<br /><strong>Hospital Clínic Barcelona</strong> \u2013 an internationally ranked, tier-1 university hospital group."
    formTitle="Understand whether fertility preservation is the right step for you"
    bgImage={u + '2026/02/HERO-IMG-2-1.png'}
  />

  <ProfileSelector cards={profileCards} />

  <SplitSection
    titlePlain="When motherhood is not for now, protecting future options can be"
    titleAccent="a meaningful decision"
    paragraphs={[
      'Not every woman wants or needs to become a mother at the same stage of life.',
      'For some, this decision is shaped by personal, professional, or relationship circumstances. For others, it is influenced by a medical treatment, a gynaecological condition, or the awareness that fertility may not remain stable for as long as expected.',
    ]}
    image={u + '2026/02/Rectangle-866.png'}
    imageSide="left"
  >
    <p style="margin-top:20px"><strong class="accent-text">You may be asking yourself:</strong></p>
    <ul class="slot-bullets">
      <li>Am I still at a good age to preserve my fertility?</li>
      <li>Should I consider egg freezing now rather than later?</li>
      <li>How do I know whether my ovarian reserve is still suitable?</li>
      <li>What does the process involve, and how demanding is it?</li>
      <li>Can this help me protect future possibilities without creating false expectations?</li>
    </ul>
    <p style="margin-top:18px;color:var(--color-body)">What matters here is not urgency for its own sake. It is understanding whether acting now may help you keep meaningful reproductive options open for the future.</p>
  </SplitSection>

  <SplitSection
    titlePlain="Why FIVClínic is the right place"
    titleAccent="for your journey"
    paragraphs={[
      '<strong>Fertility preservation should begin with an honest answer, not a sales pitch.</strong> What matters is whether this step makes clinical sense for your specific situation.',
      'At <strong>FIVClínic</strong>, the assessment comes before the treatment recommendation. We review your ovarian reserve, your age, your medical context, and your reproductive goals before advising on whether preservation is a viable and meaningful option, not as a default response to age or anxiety.',
      'Being part of <strong>barnaclínic+</strong>, the private medicine programme of <strong>Hospital Clínic Barcelona</strong>, means operating within one of Europe\u2019s most respected university hospital environments. That is not an incidental detail: it is what shapes the protocols, the laboratory standards, and the multidisciplinary resources behind every case.',
      '<strong>You don\u2019t need a generic protocol. You need care designed around you.</strong>',
    ]}
    image={u + '2026/02/Group-763.png'}
    imageSide="right"
    surface={true}
    wideImage={true}
  />

  <ScientificRigor
    titlePlain="Scientific rigor,"
    titleAccent="always grounded in perspective."
    subtitle="Fertility care is not one-size-fits-all.<br />At <strong>fivclínic:</strong>"
    items={rigorItems}
    note="FIVClínic is also clear that vitrified oocytes do not guarantee a future pregnancy, an important distinction that shapes the entire counselling approach from the start."
  />

  <WhyBarcelonaCards />

  <section class="section section-surface fp-blocks">
    <div class="container">
      <h2 class="fp-title">A specialized approach to <span class="accent">your future fertility</span></h2>

      {blocks.map((b) => (
        <div class:list={['fp-grid', { 'image-left': b.imageSide === 'left' }]}>
          <div class="fp-copy">
            <h3><span class="plus">+</span> {b.title}</h3>
            {b.intro.map((p) => <p set:html={p} />)}
            <div class="fp-box">
              <p class="fp-group-intro" set:html={b.boxIntro} />
              <ul>
                {b.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
            {b.closing.map((cl) => <p class="fp-closing" set:html={cl} />)}
            <div class="fp-hint">
              <span class="hint-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#fff" stroke-width="2"><path d="M12 16V4m0 12l-4-4m4 4l4-4" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 18v2h16v-2" stroke-linecap="round"/></svg>
              </span>
              <p>Not sure whether fertility preservation is right for you? Download our guide to understand your options before making a decision.</p>
            </div>
            <a href="#" class="btn fp-cta">Download free fertility preservation guide</a>
          </div>
          <div class="fp-media">
            <img src={b.image} alt="" loading="lazy" />
          </div>
        </div>
      ))}
    </div>
  </section>

  <SplitSection
    titlePlain="What is needed"
    titleAccent="to evaluate fertility preservation"
    paragraphs={[
      'At <strong>FIVClínic+</strong>, the process begins with a study of ovarian reserve and a general health evaluation. The main tools used are:',
    ]}
    bullets={[
      '<strong>Gynaecological ultrasound</strong>, to assess antral follicle count',
      '<strong>Blood analysis</strong>, to measure Anti-M\u00fcllerian Hormone (AMH)',
      '<strong>Medical review</strong>, to identify contraindications or clinically relevant factors',
    ]}
    image={u + '2026/04/Group-766-1.png'}
    imageSide="left"
  >
    <p style="margin-top:18px;color:var(--color-body)">This assessment allows the team to advise you on whether fertility preservation is appropriate, how time-sensitive the decision may be, and what realistic expectations look like in your specific case.</p>
  </SplitSection>

  <TreatmentProcess
    steps={processSteps}
    titleAccent="How the process works"
    titlePlain="from assessment to egg storage"
  />

  <SplitSection
    titlePlain="A way to protect future possibilities,"
    titleAccent="not a promise of certainty"
    paragraphs={[
      'Fertility preservation can be a valuable option, but it should be explained honestly.',
      'Vitrifying oocytes does not guarantee a future pregnancy. Not all eggs survive thawing, and not all lead to viable embryos. At the same time, preserving eggs at a younger age can help maintain a reproductive potential that may be significantly lower later on.',
      'What fertility preservation can offer is not certainty. It is the possibility of making future decisions with more options than you might otherwise have had.',
    ]}
    image={u + '2026/04/Rectangle-881.png'}
    imageSide="right"
  />

  <ClinicalExperienceIVF />

  <PlanningAbroad
    intro="Many patients who come to <strong>FIVClínic+</strong> for fertility preservation are coordinating from outside Barcelona, sometimes from another country entirely. The practical questions are real: how does treatment fit around work and travel? How much time does it actually require?<br /><br />We have structured our process to give those answers clearly, so that coordinating treatment from a distance is as straightforward as it can be."
    faqs={intlFaqs}
  />

  <FAQAccordion faqs={realFaqs} columns={2} />

  <SplitSection
    titlePlain="A more secure future begins with"
    titleAccent="an informed decision in the present"
    paragraphs={['When fertility preservation is considered at the right moment and for the right reasons:']}
    bullets={['Future options may remain more open', 'Decisions feel less reactive and more deliberate', 'Timing becomes part of the strategy, not just a source of stress', 'The process feels grounded in your real fertility situation']}
    image={u + '2026/02/Rectangle-884.png'}
    imageSide="right"
  >
    <p style="margin-top:18px;color:var(--color-body)">Preserving fertility is not the right step for every woman. What we offer is the assessment and the honest clinical perspective to know whether it is the right step for you.</p>
    <p style="color:var(--color-body)">That answer, grounded in your actual fertility situation, is what drives every recommendation we make.</p>
  </SplitSection>

  <ValueEvaluation
    title="The value of evaluating fertility before urgency takes over"
    paragraphs={[
      'A thorough evaluation at the right moment can help ensure that whatever path you choose is based on your current fertility reality, not on assumptions.',
      'For some women, fertility preservation is worth doing now. For others, the most valuable next step is simply understanding their ovarian reserve and reproductive timeline with greater precision. That is what turns a future-oriented decision into a medically grounded one.',
    ]}
  />

  <PatientVoices testimonials={fpTestimonials} titlePlain="" titleAccent="What patients say about us" eyebrow="" variant="gray" />

  <MedicalRecognition />

  <LeadForm titlePlain="Take the next step with" titleAccent="expert guidance and a plan built around your future." />
</Layout>

<style>
  .accent-text { color: var(--color-accent); }

  .fp-title { font-size: clamp(1.6rem, 2.6vw, 2.2rem); font-weight: 500; margin-bottom: 40px; }
  .fp-title .accent { color: var(--color-accent); }
  .fp-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; padding-block: 40px; border-bottom: 1px solid var(--color-accent); }
  .fp-grid:last-child { border-bottom: none; }
  .fp-grid.image-left { grid-template-columns: 0.9fr 1.1fr; }
  .fp-grid.image-left .fp-media { order: -1; }
  .fp-copy h3 { font-size: 1.2rem; font-weight: 600; color: var(--color-accent); display: flex; gap: 8px; align-items: baseline; margin-bottom: 14px; }
  .fp-copy h3 .plus { font-weight: 400; }
  .fp-copy > p { font-size: 0.95rem; color: var(--color-body); }
  .fp-box { background: var(--color-white); border-radius: var(--radius-md); padding: 22px 24px; margin: 18px 0; }
  .fp-group-intro { font-weight: 600; color: var(--color-heading); margin: 0 0 10px; }
  .fp-box ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .fp-box li { position: relative; padding-left: 22px; font-size: 0.9rem; color: var(--color-heading); }
  .fp-box li::before { content: ''; position: absolute; left: 0; top: 7px; width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); }
  .fp-closing { font-size: 0.95rem; color: var(--color-body); }
  .fp-hint { display: flex; align-items: flex-start; gap: 10px; margin: 16px 0; }
  .hint-icon { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: var(--color-accent); flex-shrink: 0; }
  .fp-hint p { font-size: 0.88rem; color: var(--color-accent); margin: 0; }
  .fp-cta {
    display: inline-block; width: 100%; text-align: center;
    background: var(--color-white); border: 1px solid var(--color-accent); color: var(--color-accent);
    border-radius: var(--radius-pill); padding: 1.1em 2em;
    font-size: 0.82rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .fp-cta:hover { background: var(--color-accent); color: var(--color-white); }
  .fp-media img { width: 100%; border-radius: 160px 12px 12px 12px; aspect-ratio: 4 / 5; object-fit: cover; }

  @media (max-width: 900px) {
    .fp-grid, .fp-grid.image-left { grid-template-columns: 1fr; }
    .fp-media, .fp-grid.image-left .fp-media { order: -1; }
  }
</style>
