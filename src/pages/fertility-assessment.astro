</style>

<script is:inline>

(function() {
  var fivCurrentStep = 1;
  var fivTotalSteps = 5;
  var fivUploadedFiles = [];
  var fivSelections = {};

  window.fivGoToStep = function(n) {
    // Validar antes de avanzar (no al retroceder)
    if (n > fivCurrentStep) {
      if (!fivValidarPaso(fivCurrentStep)) return;
    }

    var current = document.getElementById('fiv-step-' + fivCurrentStep);
    if (current) current.classList.remove('fiv-active');
    fivCurrentStep = n;

    var track = document.getElementById('fivProgressTrack');
    var fill = document.getElementById('fivProgressFill');
    if (n === 1) {
      track.style.display = 'none';
    } else {
      track.style.display = 'block';
      var pct = Math.round(((n - 1) / fivTotalSteps) * 100);
      fill.style.width = pct + '%';
    }
    var next = document.getElementById('fiv-step-' + n);
    if (next) next.classList.add('fiv-active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  function fivValidarPaso(paso) {
    fivLimpiarErrores();

    if (paso === 2) {
      var edad   = document.getElementById('fiv-edad').value.trim();
      var pais   = document.getElementById('fiv-pais').value;
      var tiempo = document.getElementById('fiv-tiempo').value;
      if (!edad)   { fivErrorCampo('fiv-edad',   'Please enter your age'); return false; }
      if (!pais)   { fivErrorCampo('fiv-pais',   'Please select your country'); return false; }
      if (!tiempo) { fivErrorCampo('fiv-tiempo', 'Please select an option'); return false; }
    }

    if (paso === 3) {
      if (!fivSelections['fiv-tratamientos']) { fivErrorGrupo('fiv-tratamientos', 'Please select an option'); return false; }
      if (!fivSelections['fiv-diagnostico'])  { fivErrorGrupo('fiv-diagnostico',  'Please select an option'); return false; }
      if (!fivSelections['fiv-pareja'])       { fivErrorGrupo('fiv-pareja',       'Please select an option'); return false; }
    }

    // Step 4 — documents optional, not blocking
    // Uncomment to make mandatory:
    // if (paso === 4) {
    //   if (fivUploadedFiles.length === 0) { fivErrorGeneral('Please upload at least one document'); return false; }
    // }

    if (paso === 5) {
      if (!fivSelections['fiv-objetivo']) { fivErrorGrupo('fiv-objetivo', 'Please select an option'); return false; }
      if (!fivSelections['fiv-cuando'])   { fivErrorGrupo('fiv-cuando',   'Please select an option'); return false; }
    }

    return true;
  }

  function fivErrorCampo(fieldId, msg) {
    var el = document.getElementById(fieldId);
    if (!el) return;
    el.classList.add('fiv-input-error');
    var err = document.createElement('span');
    err.className = 'fiv-error-msg';
    err.textContent = msg;
    el.parentNode.appendChild(err);
    el.focus();
  }

  function fivErrorGrupo(grupoId, msg) {
    var el = document.getElementById(grupoId);
    if (!el) return;
    var err = document.createElement('span');
    err.className = 'fiv-error-msg';
    err.textContent = msg;
    el.parentNode.appendChild(err);
  }

  function fivLimpiarErrores() {
    document.querySelectorAll('#fiv-multistep-wrap .fiv-error-msg').forEach(function(e) { e.remove(); });
    document.querySelectorAll('#fiv-multistep-wrap .fiv-input-error').forEach(function(el) {
      el.classList.remove('fiv-input-error');
    });
  }

  window.fivSelect = function(groupId, btn) {
    var group = document.getElementById(groupId);
    group.querySelectorAll('.fiv-option-btn').forEach(function(b) {
      b.classList.remove('fiv-selected');
    });
    btn.classList.add('fiv-selected');
    // Extraer el texto sin el dot
    var text = btn.textContent.trim();
    fivSelections[groupId] = text;
  };

  // Rutas de archivos ya subidos al servidor vía AJAX
  var fivUploadedPaths = [];

  window.fivHandleFiles = function(files) {
    Array.from(files).forEach(function(file) {
      if (!fivUploadedFiles.find(function(f) { return f.name === file.name; })) {
        fivUploadedFiles.push(file);
      }
    });
    fivRenderFileList();
  };

  function fivRenderFileList() {
    var list = document.getElementById('fivFileList');
    list.innerHTML = '';
    fivUploadedFiles.forEach(function(file, i) {
      var item = document.createElement('div');
      item.className = 'fiv-upload-item';
      item.innerHTML = '<svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="2" y="1" width="10" height="12" rx="1.5" stroke="#E04403" stroke-width="1.2"/><path d="M5 5h4M5 7.5h4M5 10h2" stroke="#E04403" stroke-width="1" stroke-linecap="round"/></svg><span>' + file.name + '</span><button class="fiv-upload-remove" onclick="fivRemoveFile(' + i + ')" type="button">×</button>';
      list.appendChild(item);
    });
  }

  window.fivRemoveFile = function(i) {
    fivUploadedFiles.splice(i, 1);
    fivRenderFileList();
  };

  // Drag & drop
  var zone = document.getElementById('fivUploadZone');
  zone.addEventListener('dragover', function(e) { e.preventDefault(); zone.classList.add('fiv-drag-over'); });
  zone.addEventListener('dragleave', function() { zone.classList.remove('fiv-drag-over'); });
  zone.addEventListener('drop', function(e) {
    e.preventDefault();
    zone.classList.remove('fiv-drag-over');
    fivHandleFiles(e.dataTransfer.files);
  });

  // Upload files to server via AJAX when moving from step 4 to 5
  // Called from the "Continue" button on step 4
  window.fivSubirArchivosYContinuar = function() {
    if (!fivValidarPaso(4)) return;
    // Static mockup: files are kept client-side only
    fivGoToStep(5);
  };

  // On Continue in step 5: populate Elementor Form hidden fields and show it
  window.fivActivarFormularioContacto = function() {
    if (!fivValidarPaso(5)) return;

    // Elementor generates IDs with prefix "form-field-"
    var data = {
      'form-field-fiv_edad':         document.getElementById('fiv-edad').value || 'Not provided',
      'form-field-fiv_pais':         document.getElementById('fiv-pais').value || 'Not provided',
      'form-field-fiv_tiempo':       document.getElementById('fiv-tiempo').value || 'Not provided',
      'form-field-fiv_tratamientos': fivSelections['fiv-tratamientos'] || 'Not answered',
      'form-field-fiv_diagnostico':  fivSelections['fiv-diagnostico'] || 'Not answered',
      'form-field-fiv_pareja':       fivSelections['fiv-pareja'] || 'Not answered',
      'form-field-fiv_objetivo':     fivSelections['fiv-objetivo'] || 'Not answered',
      'form-field-fiv_cuando':       fivSelections['fiv-cuando'] || 'Not answered',
      // Uploaded file paths (hidden field in the form)
      'form-field-fiv_rutas_archivos': fivUploadedPaths.join('||'),
    };

    Object.keys(data).forEach(function(key) {
      var el = document.getElementById(key);
      if (el) el.value = data[key];
    });

    // Hide HTML widget, show Elementor Form
    document.getElementById('fiv-multistep-wrap').style.display = 'none';
    var efWrap = document.getElementById('fiv-elementor-form-wrap');
    if (efWrap) {
      efWrap.style.display = 'block';
      efWrap.style.animation = 'fivFadeUp 0.3s ease';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  };

})();

</script>
