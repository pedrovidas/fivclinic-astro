---
import Layout from '../layouts/Layout.astro';
import TreatmentHero from '../components/treatment/TreatmentHero.astro';
import SplitSection from '../components/treatment/SplitSection.astro';
import ScientificRigor from '../components/treatment/ScientificRigor.astro';
import WhyBarcelonaCards from '../components/treatment/WhyBarcelonaCards.astro';
import TreatmentProcess from '../components/treatment/TreatmentProcess.astro';
import ExperienceCounters from '../components/treatment/ExperienceCounters.astro';
import PlanningAbroad from '../components/treatment/PlanningAbroad.astro';
import FAQAccordion from '../components/treatment/FAQAccordion.astro';
import PatientVoices from '../components/home/PatientVoices.astro';
import MedicalRecognition from '../components/home/MedicalRecognition.astro';
import LeadForm from '../components/home/LeadForm.astro';
import { rplRigorIcons } from '../data/rplRigorIcons';

const u = 'https://fivclinic.es/international-patients/wp-content/uploads/';

const rigorItems = [
  { text: 'Each case is reviewed thoroughly, not superficially', icon: rplRigorIcons[0] },
  { text: 'Investigations are chosen carefully, not automatically', icon: rplRigorIcons[1] },
  { text: 'Findings are explained clearly, not delivered as conclusions', icon: rplRigorIcons[2] },
  { text: 'Emotional support is integrated into clinical care', icon: rplRigorIcons[3] },
];

const evaluateGroups = [
  { title: 'Genetic factors', items: ['Embryonic chromosomal abnormalities', 'Parental genetic considerations', 'Indications for PGT-A when appropriate'] },
  { title: 'Uterine and anatomical factors', items: ['Congenital or acquired uterine conditions', 'Imaging and assessment of implantation environment'] },
  { title: 'Hormonal and metabolic factors', items: ['Thyroid function', 'Progesterone support', 'Endocrine imbalances'] },
  { title: 'Immunological and hematological considerations', items: ['When clinically indicated, and never routinely'] },
];

const processSteps = [
  { icon: u + '2026/02/Group-767.svg', title: 'Detailed case review', text: 'We review your pregnancy history, reports, test results, and previous evaluations.' },
  { icon: u + '2026/02/Group-768.svg', title: 'Multidisciplinary assessment', text: 'Your case is assessed collaboratively by specialists in reproductive medicine, genetics, and other relevant fields.' },
  { icon: u + '2026/02/Group-769.svg', title: 'Clear explanation and findings', listIntro: 'We explain:', list: ['What may be contributing to pregnancy loss', 'Which factors are most relevant in your case', 'What options are available — and which are not supported by evidence'] },
  { icon: u + '2026/02/Group-657.svg', title: 'Guided decision-making', text: 'You are supported medically and emotionally in deciding how — or whether — to move forward.' },
];

const counters = [
  { value: 30, suffix: '+', label: 'years', sub: 'of specialized experience in reproductive medicine at FIVClínic' },
  { value: 65, suffix: '%', label: 'pregnancy rate', sub: 'in IVF treatments with own eggs', subItalic: 'Clinic-reported outcomes' },
  { value: 80, suffix: '%', label: 'pregnancy rate', sub: 'donor egg cycles', subItalic: 'Clinic-reported outcomes' },
  { value: 642, suffix: 'K+', label: 'outpatient visits', sub: 'per year at Hospital Clínic Barcelona' },
  { value: 31, suffix: 'K+', label: 'surgical interventions', sub: 'performed at Hospital Clínic Barcelona' },
  { value: 100, suffix: '+', label: 'years', sub: 'of clinical, research, and teaching activity', subItalic: 'Hospital Clínic Barcelona, founded in 1906' },
];

const intlFaqs = [
  { q: 'What is the process like for patients from abroad?', a: 'Your journey begins with an expert case review, which can be initiated online. Our team evaluates your medical information and provides clear guidance on next steps before any trip is planned.' },
  { q: 'Can consultations be done online?', a: 'Yes. Initial consultations and case reviews can be carried out online, allowing you to receive expert guidance without traveling until it is truly necessary.' },
  { q: 'Is support offered to help prepare for the trip?', a: 'Yes. Our international patient team assists with:', list: ['Scheduling and coordination of appointments', 'Guidance on timing and duration of stay', 'Preparation of medical documentation', 'Communication in English throughout the process'], foot: 'Our goal is to make the process as smooth and predictable as possible.' },
  { q: 'Is the first consultation free?', a: 'The initial expert case review is offered without obligation. Any subsequent steps are clearly explained in advance so you can make informed decisions.' },
  { q: 'Who will support me during the process?', a: 'You will be supported by:', list: ['A medical team specialized in your case', 'An international patient coordinator', 'English-speaking staff available throughout your journey'], foot: 'You are never navigating the process alone.' },
];

const faqs = [
  { q: 'What is recurrent pregnancy loss (RPL)?', a: 'Recurrent pregnancy loss (RPL) usually refers to two or more consecutive miscarriages, typically occurring before 20 weeks of pregnancy. It is considered a medical condition that often requires a specific diagnostic approach, different from infertility or IVF failure.' },
  { q: 'What tests are usually recommended for RPL?', a: 'There is no single test for RPL. Depending on your history, evaluation may include:<ul><li>Genetic assessment (of embryos or parents)</li><li>Uterine imaging</li><li>Hormonal and metabolic testing</li><li>Targeted immunological or hematological studies</li></ul>Only tests that add meaningful information should be recommended.' },
  { q: 'Why do miscarriages keep happening even if I can get pregnant?', a: 'When explanations have not been clear, when the same protocol is repeated without changes, or when results don\u2019t align with what would be expected for your situation.' },
  { q: 'Can IVF or PGT-A help prevent further miscarriages?', a: 'In some cases, IVF combined with preimplantation genetic testing (PGT-A) may help reduce the risk of miscarriage caused by chromosomal abnormalities. However, it is not appropriate for every patient. Whether it makes sense depends on age, reproductive history, and findings from your evaluation.' },
  { q: 'Is recurrent pregnancy loss always caused by genetics?', a: 'No. While chromosomal abnormalities are a common cause of miscarriage, genetics is only one possible factor. Uterine anatomy, hormonal balance, immune-related conditions, and other medical factors can also contribute. A thorough evaluation helps determine whether genetics are playing a role in your case.' },
  { q: 'Can the evaluation and first consultation be done online?', a: 'Yes. Initial consultations can be carried out online, including review of medical history and reports. This is especially helpful for international patients or those seeking a second opinion before deciding on next steps.' },
  { q: 'When should I stop trying and ask for a specialist evaluation?', a: 'If you have experienced two or more miscarriages, or if a miscarriage occurred after fertility treatment, it is reasonable to seek a specialist review before trying again. Further attempts without investigation can increase emotional distress without improving outcomes.' },
  { q: 'Is there always a clear explanation for recurrent pregnancy loss?', a: 'Not always. In some cases, no single cause can be identified. Even then, a structured evaluation helps:<ul><li>Rule out significant conditions</li><li>Clarify realistic options</li><li>Avoid unnecessary or ineffective treatments</li></ul>Understanding what is <strong>known — and what is uncertain —</strong> can still provide clarity and guide safer decision-making.' },
];

const rplTestimonials = [
  { quote: 'For the first time, we understood what had happened in each IVF cycle.', author: 'Patient after failed IVF' },
  { quote: 'They were honest with me without taking away hope.', author: 'Woman aged 41' },
  { quote: 'They explained our genetic situation clearly and without fear.', author: 'Couple with genetic concerns' },
];
---

<Layout
  title="Repeated Pregnancy Loss Care in Barcelona | FIVClínic"
  description="Clear answers for repeated pregnancy loss (RPL) at FIVClínic Barcelona — specialized evaluation and honest guidance backed by Hospital Clínic Barcelona."
>
  <TreatmentHero
    titlePlain="Clear answers for"
    titleAccent="repeated pregnancy loss"
    accentFirst={false}
    lead="Experiencing more than one miscarriage is devastating — emotionally and physically. And too often, patients are left without clear explanations."
    paragraphs={[
      'At <strong>FIVClínic</strong>, we specialize in <strong>the evaluation and management of recurrent pregnancy loss (RPL) — also known as repeated or recurrent miscarriages</strong> — helping patients understand why pregnancies may not be continuing and what can realistically be done next.',
    ]}
    note="FIVClínic is the assisted reproduction department of barnaclínic+, backed by<br /><strong>Hospital Clínic Barcelona</strong> \u2013 an internationally ranked, tier-1 university hospital group."
    formTitle="Understand your IVF treatment options with an expert"
    bgImage={u + '2026/04/repeated-pregnancy-loss.png'}
  />

  <SplitSection
    titlePlain="When pregnancy keeps ending,"
    titleAccent="uncertainty becomes unbearable."
    paragraphs={[
      'Recurrent pregnancy loss — often defined as <strong>two or more consecutive miscarriages</strong> — is one of the most painful and confusing experiences in reproductive medicine.',
      '<strong>Many patients find themselves in the same situation:</strong>',
    ]}
    bullets={['They can get pregnant', 'Tests appear \u201cnormal\u201d', 'But pregnancies don\u2019t progress']}
    image={u + '2026/02/Rectangle-866.png'}
    imageSide="left"
  >
    <p style="margin-top:20px"><strong class="accent-text">You may be asking yourself:</strong></p>
    <ul class="slot-bullets">
      <li>Why does this keep happening to me?</li>
      <li>Is something being missed in my evaluation?</li>
      <li>Could genetics, anatomy, hormones, or immune factors be involved?</li>
      <li>Should I try again — or stop and investigate further?</li>
    </ul>
    <p style="margin-top:18px;color:var(--color-body)">Without answers, moving forward can feel frightening and overwhelming.</p>
  </SplitSection>

  <SplitSection
    titlePlain="Why FIVClínic is the right place"
    titleAccent="for your journey"
    paragraphs={[
      '<strong>You don\u2019t need reassurance. You need understanding.</strong>',
      '<strong>FIVClínic</strong> focuses on careful investigation and honest medical guidance for patients experiencing recurrent pregnancy loss.',
      'Our work is supported by the clinical standards and multidisciplinary environment of <strong>Hospital Clínic Barcelona</strong>, one of Europe\u2019s leading university hospitals.',
      'We act as your guide — reviewing your history in depth, coordinating specialist input, and helping you understand <strong>what may be contributing to pregnancy loss and what steps truly make sense next.</strong>',
    ]}
    image={u + '2026/02/Group-763.png'}
    imageSide="right"
    surface={true}
    wideImage={true}
  />

  <ScientificRigor
    titlePlain="Scientific investigation, explained with care."
    titleAccent="Human support, always present."
    subtitle="Recurrent pregnancy loss cannot be addressed with assumptions or rushed conclusions.<br />At <strong>fivclínic:</strong>"
    items={rigorItems}
    note="Here, understanding is part of the treatment."
  />

  <WhyBarcelonaCards
    intro="Barcelona is <strong>one of Europe\u2019s leading destinations for advanced medical care,</strong> combining <strong>clinical excellence, innovation, and an international healthcare ecosystem.</strong>"
    footer="<strong>FIVClínic+</strong> benefits directly from this ecosystem, with its clinical approach supported by the medical excellence and standards of Hospital Clínic Barcelona, one of the most respected academic hospitals in Spain and Europe."
  />

  <section class="section section-surface rpl-approach">
    <div class="container">
      <h2 class="approach-title">A specialized approach to <span class="accent">recurrent pregnancy loss (RPL)</span></h2>
      <p class="approach-intro">
        Recurrent pregnancy loss often involves <strong>multiple interacting factors.</strong>
        Understanding it requires integration — not isolated tests.
      </p>

      <div class="approach-grid">
        <div class="approach-copy">
          <h3 class="evaluate-title"><span class="plus">+</span> What we carefully evaluate may include:</h3>
          <div class="evaluate-box">
            {evaluateGroups.map((g) => (
              <div class="eval-group">
                <p class="eval-group-title">{g.title}</p>
                <ul>
                  {g.items.map((it) => <li>{it}</li>)}
                </ul>
              </div>
            ))}
          </div>
          <p class="approach-note">
            Each recommendation is explained clearly, so you can decide with confidence — without fear or pressure.
          </p>
          <div class="approach-hint">
            <span class="hint-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#fff" stroke-width="2"><path d="M12 16V4m0 12l-4-4m4 4l4-4" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 18v2h16v-2" stroke-linecap="round"/></svg>
            </span>
            <p>Get clear guidance on recurrent pregnancy loss, possible causes and the next steps to discuss with a specialist.</p>
          </div>
          <a href="#" class="btn approach-cta">Get the free RPL guide</a>
        </div>
        <div class="approach-media">
          <img src={u + '2026/04/repeated-pregnancy-loss-specialized.png'} alt="" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <TreatmentProcess
    steps={processSteps}
    titleAccent="A structured, step-by-step approach"
    titlePlain="to understanding RPL"
  />

  <ExperienceCounters counters={counters} />

  <PlanningAbroad
    titlePlain="Support for"
    titleAccent="international patients"
    titleTail="at every step"
    intro="We understand that pursuing fertility treatment abroad requires clarity, coordination, and trust. <strong>FIVClínic</strong> offers a structured and supportive process designed specifically for international patients."
    faqs={intlFaqs}
  />

  <FAQAccordion faqs={faqs} columns={2} />

  <SplitSection
    titlePlain="Understanding"
    titleAccent="changes everything."
    paragraphs={['When you truly understand what may be happening:']}
    bullets={['Uncertainty becomes manageable', 'Decisions feel grounded and calmer', 'The next step becomes clearer — whatever it may be']}
    image={u + '2026/02/Rectangle-884.png'}
    imageSide="right"
  >
    <p style="margin-top:18px;color:var(--color-body)">Whether that step involves further investigation, treatment, or a different path altogether, clarity helps restore confidence and control.</p>
  </SplitSection>

  <section class="section avoid-outer">
    <div class="container">
      <div class="avoid-head">
        <span class="avoid-plus" aria-hidden="true">+</span>
        <h2 class="avoid-title">Avoid trying again without understanding why.</h2>
      </div>
      <div class="avoid-box">
        <p class="avoid-sub">Avoid trying again without understanding why.</p>
        <ul>
          <li>Emotional exhaustion</li>
          <li>Loss of trust</li>
          <li>Missed opportunities to adjust strategy</li>
        </ul>
        <p class="avoid-foot">A thorough, honest evaluation helps avoid repeating the same path without new insight.</p>
      </div>
    </div>
  </section>

  <PatientVoices testimonials={rplTestimonials} titlePlain="" titleAccent="What patients say about us" eyebrow="" variant="gray" />

  <MedicalRecognition />

  <LeadForm titlePlain="Take the next step with" titleAccent="clarity and expert guidance." />
</Layout>

<style>
  .accent-text { color: var(--color-accent); }

  .approach-title { font-size: clamp(1.6rem, 2.6vw, 2.2rem); font-weight: 500; margin-bottom: 12px; }
  .approach-title .accent { color: var(--color-accent); }
  .approach-intro { color: var(--color-body); max-width: 62ch; margin-bottom: 36px; }
  .approach-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: start; }
  .evaluate-title { font-size: 1.15rem; font-weight: 600; color: var(--color-accent); display: flex; gap: 8px; align-items: baseline; margin-bottom: 16px; }
  .evaluate-title .plus { font-weight: 400; }
  .evaluate-box { background: var(--color-white); border-radius: var(--radius-md); padding: 26px 28px; display: flex; flex-direction: column; gap: 20px; }
  .eval-group-title { font-weight: 600; color: var(--color-heading); margin: 0 0 8px; }
  .eval-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .eval-group li { position: relative; padding-left: 20px; font-size: 0.9rem; color: var(--color-body); }
  .eval-group li::before { content: ''; position: absolute; left: 0; top: 7px; width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); }
  .approach-note { margin-top: 20px; color: var(--color-body); font-size: 0.92rem; }
  .approach-hint { display: flex; align-items: flex-start; gap: 10px; margin: 14px 0 18px; }
  .hint-icon { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: var(--color-accent); flex-shrink: 0; }
  .approach-hint p { font-size: 0.88rem; color: var(--color-accent); margin: 0; }
  .approach-cta {
    display: inline-block; width: 100%; text-align: center;
    background: var(--color-white); border: 1px solid var(--color-accent); color: var(--color-accent);
    border-radius: var(--radius-pill); padding: 1.1em 2em;
    font-size: 0.82rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .approach-cta:hover { background: var(--color-accent); color: var(--color-white); }
  .approach-media img { width: 100%; border-radius: var(--radius-md); }

  .avoid-outer { background: #F5F5F5; }
  .avoid-head { display: flex; align-items: center; justify-content: center; gap: 14px; margin-bottom: 24px; }
  .avoid-plus { font-size: clamp(2.4rem, 4vw, 3.4rem); font-weight: 300; color: var(--color-accent-light); line-height: 1; }
  .avoid-title { font-size: clamp(1.2rem, 2vw, 1.6rem); font-weight: 600; color: var(--color-accent); margin: 0; text-align: center; }
  .avoid-box { background: var(--color-white); border-radius: var(--radius-md); padding: clamp(28px, 4vw, 48px); max-width: 900px; margin-inline: auto; }
  .avoid-sub { font-weight: 600; color: var(--color-heading); margin: 0 0 20px; }
  .avoid-box ul { list-style: none; margin: 0 0 20px; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .avoid-box li { position: relative; padding-left: 22px; font-size: 0.95rem; color: var(--color-body); }
  .avoid-box li::before { content: ''; position: absolute; left: 0; top: 8px; width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
  .avoid-foot { margin: 0; color: var(--color-body); font-size: 0.95rem; }

  @media (max-width: 900px) {
    .approach-grid { grid-template-columns: 1fr; }
    .approach-media { order: -1; }
  }
</style>
