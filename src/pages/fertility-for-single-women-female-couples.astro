---
import {
  storyblokEditable,
} from '@storyblok/astro';
import Layout from '../layouts/Layout.astro';
import TreatmentHero from '../components/treatment/TreatmentHero.astro';
import ProfileSelector from '../components/treatment/ProfileSelector.astro';
import SplitSection from '../components/treatment/SplitSection.astro';
import ScientificRigor from '../components/treatment/ScientificRigor.astro';
import WhyBarcelonaCards from '../components/treatment/WhyBarcelonaCards.astro';
import TreatmentProcess from '../components/treatment/TreatmentProcess.astro';
import ClinicalExperienceIVF from '../components/treatment/ClinicalExperienceIVF.astro';
import PlanningAbroad from '../components/treatment/PlanningAbroad.astro';
import FAQAccordion from '../components/treatment/FAQAccordion.astro';
import ValueEvaluation from '../components/treatment/ValueEvaluation.astro';
import PatientVoices from '../components/home/PatientVoices.astro';
import MedicalRecognition from '../components/home/MedicalRecognition.astro';
import LeadForm from '../components/home/LeadForm.astro';
import { swRigorIcons } from '../data/swRigorIcons';
import { getStoryblokPageContent } from '../lib/storyblokPageContent.js';

const content = await getStoryblokPageContent(
  'fertility-for-single-women-female-couples',
  Astro.locals,
);

const u = 'https://fivclinic.es/international-patients/wp-content/uploads/';

const profileCards = content.profileCards;

const rigorItems = content.rigorItems.map((r: any, i: number) => ({ ...r, icon: swRigorIcons[i] }));

const blocks = content.blocks;

const processSteps = content.processSteps;

const intlFaqs = content.intlFaqs;

const realFaqs = content.realFaqs;

const swTestimonials = content.swTestimonials;

const storyblokPageAttributes =
  content.__storyblok
    ? storyblokEditable(content.__storyblok)
    : {};

---

<Layout
  title="Fertility for Single Women & Female Couples | FIVClínic"
  description="Fertility treatment for women pursuing motherhood without a male partner — donor insemination, IVF and the ROPA method at FIVClínic Barcelona."
>
  <div
    class="storyblok-page-editable"
    style="display: contents"
    {...storyblokPageAttributes}
  >
  <TreatmentHero
    titlePlain="pursuing motherhood without a male partner"
    titleAccent="Fertility treatment for women"
    lead="Expert, personalized care for single women and female couples"
    paragraphs={[
      'At <strong>FIVClinic+</strong>, we support women building their family without a male partner through a medical approach that is individualized, evidence-based, and respectful of each family project.',
      'For some patients, the right first step may be donor insemination. For others, IVF may offer a more suitable path. In female couples, shared motherhood through the ROPA method (Reception of Oocytes from the Partner, also known as Reciprocal IVF) may also be part of the conversation.',
      'Our role is to help you understand which treatment makes sense for your situation, your fertility profile, and the way you want to build your family.',
    ]}
    note="FIVClínic is the assisted reproduction department of barnaclínic+, backed by<br /><strong>Hospital Clínic Barcelona</strong> \u2013 an internationally ranked, tier-1 university hospital group."
    formTitle="Understand which fertility treatment is right for your family project"
    bgImage={u + '2026/02/HERO-IMG-2-1.png'}
  />

  <ProfileSelector cards={profileCards} />

  <SplitSection
    titlePlain="When you want to become a mother without a male partner,"
    titleAccent="the right guidance matters"
    paragraphs={[
      'Starting a family in this context is not about overcoming infertility in the traditional sense. It is about choosing the right medical pathway, understanding your options clearly, and feeling supported by a team that respects your family model from the beginning.',
    ]}
    image={u + '2026/02/Rectangle-866.png'}
    imageSide="left"
  >
    <p style="margin-top:20px"><strong class="accent-text">You may be asking yourself:</strong></p>
    <ul class="slot-bullets">
      <li>Should I start with donor insemination or IVF?</li>
      <li>What treatment makes the most sense for my age and ovarian reserve?</li>
      <li>What are the options for female couples?</li>
      <li>Can both women be involved in the process?</li>
      <li>How is donor sperm selected in Spain?</li>
      <li>What does the process look like if I live outside Barcelona or outside Spain?</li>
    </ul>
    <p style="margin-top:18px;color:var(--color-body)">At this stage, what matters most is not being pushed toward one treatment, but being guided toward the one that fits your situation best.</p>
  </SplitSection>

  <SplitSection
    titlePlain="Why FIVClínic is the right place"
    titleAccent="for your journey"
    paragraphs={[
      'At FIVClinic, every treatment plan begins with your personal, reproductive, and family context.',
      '<strong>That means understanding:</strong>',
    ]}
    bullets={[
      'Your age and ovarian reserve',
      'Whether donor insemination is suitable',
      'Whether IVF may offer a stronger chance of success',
      'Whether shared motherhood is something you wish to explore as a female couple',
      'What timing makes sense for your plans',
    ]}
    image={u + '2026/02/Group-763.png'}
    imageSide="right"
    surface={true}
    wideImage={true}
  >
    <p style="margin-top:18px;color:var(--color-body)"><strong>You do not need assumptions. You need a fertility plan designed around your family project.</strong></p>
  </SplitSection>

  <ScientificRigor
    titlePlain="Scientific rigor,"
    titleAccent="always accompanied by respectful care"
    subtitle="Fertility care is not one-size-fits-all.<br />At <strong>fivclínic:</strong>"
    items={rigorItems}
    note="Here, expert care also means understanding that there is more than one valid way to create a family."
  />

  <WhyBarcelonaCards />

  <section class="section section-surface sw-blocks">
    <div class="container">
      <h2 class="sw-title">A specialized approach for <span class="accent">women pursuing motherhood without a male partner</span></h2>

      {blocks.map((b) => (
        <div class:list={['sw-grid', { 'image-left': b.imageSide === 'left' }]}>
          <div class="sw-copy">
            <h3><span class="plus">+</span> {b.title}</h3>
            {b.intro.map((p) => <p set:html={p} />)}
            {b.boxIntro && (
              <div class="sw-box">
                <p class="sw-group-intro" set:html={b.boxIntro} />
                <ul>
                  {b.items.map((it) => <li>{it}</li>)}
                </ul>
              </div>
            )}
            {b.closing.map((cl) => <p class="sw-closing" set:html={cl} />)}
            <div class="sw-hint">
              <span class="hint-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#fff" stroke-width="2"><path d="M12 16V4m0 12l-4-4m4 4l4-4" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 18v2h16v-2" stroke-linecap="round"/></svg>
              </span>
              <p>{b.hint}</p>
            </div>
            <a href="#" class="btn sw-cta">Download the free guide</a>
          </div>
          <div class="sw-media">
            <img src={b.image} alt="" loading="lazy" />
          </div>
        </div>
      ))}
    </div>
  </section>

  <SplitSection
    titlePlain="How donor sperm"
    titleAccent="treatment is approached"
    paragraphs={[
      'At <strong>FIVClinic+</strong>, treatment with donor sperm begins with an individualized review of the patient\u2019s medical and reproductive situation.',
      '<strong>Before donor insemination, the process includes:</strong>',
    ]}
    bullets={[
      'Review of personal and family medical history',
      'Gynecological examination',
      'Ovarian reserve assessment through ultrasound and hormone testing',
      'Evaluation of tubal patency when needed',
      'General health assessment',
    ]}
    image={u + '2026/04/Group-766-1.png'}
    imageSide="left"
  >
    <p style="margin-top:18px;color:var(--color-body)">For sperm-bank treatments, donor selection is based on physical characteristics and blood group, seeking the greatest physical and immunological similarity possible.</p>
    <p style="color:var(--color-body)">This allows treatment to be planned with both safety and personalization.</p>
  </SplitSection>

  <TreatmentProcess
    steps={processSteps}
    titleAccent="A step-by-step process"
    titlePlain="designed around your situation"
  />

  <SplitSection
    titlePlain="More than one treatment path."
    titleAccent="One family project."
    paragraphs={[
      'For women pursuing motherhood without a male partner, the most important question is not simply which treatment exists.',
      '<strong>It is which treatment offers the right balance of:</strong>',
    ]}
    bullets={[
      'Medical appropriateness',
      'Realistic chances of pregnancy',
      'Respect for your family model',
      'Emotional comfort with the process',
      'A timeline that makes sense for your life',
    ]}
    image={u + '2026/04/Rectangle-881.png'}
    imageSide="right"
  >
    <p style="margin-top:18px;color:var(--color-body)">This is why treatment should begin with good medical judgment, not assumptions.</p>
  </SplitSection>

  <ClinicalExperienceIVF />

  <PlanningAbroad
    titlePlain="Support for patients coming to"
    titleAccent="Barcelona from elsewhere in Spain or abroad"
    intro="We understand that fertility treatment sometimes needs to be planned around work, travel, family logistics, or life in another city or country.<br /><br /><strong>FIVClinic+</strong> offers a structured process that can begin with specialist guidance and coordinated planning."
    faqs={intlFaqs}
  />

  <FAQAccordion faqs={realFaqs} columns={2} />

  <SplitSection
    titlePlain="A family project deserves a treatment plan"
    titleAccent="that truly fits"
    paragraphs={['When treatment is explained properly and adapted to your real situation:']}
    bullets={['Decisions feel more grounded', 'The process becomes easier to navigate', 'Expectations become more realistic', 'The path toward motherhood feels more coherent and supported']}
    image={u + '2026/02/Rectangle-884.png'}
    imageSide="right"
  >
    <p style="margin-top:18px;color:var(--color-body)">This is not about steering every patient toward the same route.</p>
    <p style="color:var(--color-body)">It is about helping each woman or couple understand which fertility path makes the most sense for the family they want to build.</p>
  </SplitSection>

  <ValueEvaluation
    title="The value of choosing the right first step"
    paragraphs={[
      'A careful fertility evaluation can help avoid starting with a treatment that is less suited to your age, ovarian reserve, or goals.',
      'For some women, donor insemination may be the right place to begin.<br />For others, IVF may offer a more effective path from the outset.<br />For some female couples, shared motherhood may be the most meaningful option.',
      'That is why choosing well at the beginning can make the entire journey feel more focused, more efficient, and more reassuring.',
    ]}
  />

  <PatientVoices testimonials={swTestimonials} titlePlain="" titleAccent="What patients say about us" eyebrow="" variant="gray" />

  <MedicalRecognition />

  <LeadForm titlePlain="Take the next step with" titleAccent="expert guidance and a plan built around your future." />

  </div>
</Layout>

<style>
  .accent-text { color: var(--color-accent); }

  .sw-title { font-size: clamp(1.6rem, 2.6vw, 2.2rem); font-weight: 500; margin-bottom: 40px; }
  .sw-title .accent { color: var(--color-accent); }
  .sw-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; padding-block: 40px; border-bottom: 1px solid var(--color-accent); }
  .sw-grid:last-child { border-bottom: none; }
  .sw-grid.image-left { grid-template-columns: 0.9fr 1.1fr; }
  .sw-grid.image-left .sw-media { order: -1; }
  .sw-copy h3 { font-size: 1.2rem; font-weight: 600; color: var(--color-accent); display: flex; gap: 8px; align-items: baseline; margin-bottom: 14px; }
  .sw-copy h3 .plus { font-weight: 400; }
  .sw-copy > p { font-size: 0.95rem; color: var(--color-body); }
  .sw-box { background: var(--color-white); border-radius: var(--radius-md); padding: 22px 24px; margin: 18px 0; }
  .sw-group-intro { font-weight: 600; color: var(--color-heading); margin: 0 0 10px; }
  .sw-box ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .sw-box li { position: relative; padding-left: 22px; font-size: 0.9rem; color: var(--color-heading); }
  .sw-box li::before { content: ''; position: absolute; left: 0; top: 7px; width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); }
  .sw-closing { font-size: 0.95rem; color: var(--color-body); }
  .sw-hint { display: flex; align-items: flex-start; gap: 10px; margin: 16px 0; }
  .hint-icon { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: var(--color-accent); flex-shrink: 0; }
  .sw-hint p { font-size: 0.88rem; color: var(--color-accent); margin: 0; }
  .sw-cta {
    display: inline-block; width: 100%; text-align: center;
    background: var(--color-white); border: 1px solid var(--color-accent); color: var(--color-accent);
    border-radius: var(--radius-pill); padding: 1.1em 2em;
    font-size: 0.82rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .sw-cta:hover { background: var(--color-accent); color: var(--color-white); }
  .sw-media img { width: 100%; border-radius: 160px 12px 12px 12px; aspect-ratio: 4 / 5; object-fit: cover; }

  @media (max-width: 900px) {
    .sw-grid, .sw-grid.image-left { grid-template-columns: 1fr; }
    .sw-media, .sw-grid.image-left .sw-media { order: -1; }
  }
</style>
