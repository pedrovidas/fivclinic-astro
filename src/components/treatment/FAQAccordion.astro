---
interface FAQ { q: string; a: string; }
interface Props {
  titlePlain?: string;
  titleAccent?: string;
  faqs: FAQ[];
  columns?: number;
}
const { titlePlain = 'Frequently Asked', titleAccent = 'Questions', faqs, columns = 2 } = Astro.props;
---

<section class="section faq-section">
  <div class="container">
    <h2 class="text-center faq-title">{titlePlain} <span class="accent">{titleAccent}</span></h2>
    <div class="faq-grid" style={`--cols:${columns}`}>
      {faqs.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>
            <span>{item.q}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer"><p set:html={item.a} /></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-title { font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 400; margin-bottom: 40px; }
  .faq-title .accent { color: var(--color-accent); }
  .faq-grid { display: grid; grid-template-columns: repeat(var(--cols, 2), 1fr); gap: 0 48px; }
  .faq-item { border-bottom: 1px solid var(--color-border); }
  .faq-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 20px 0; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-size: 1rem; font-weight: 500; color: var(--color-heading);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-icon { position: relative; width: 16px; height: 16px; flex-shrink: 0; }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; background: var(--color-accent); transition: opacity 0.2s ease; }
  .faq-icon::before { top: 7px; left: 0; width: 16px; height: 2px; }
  .faq-icon::after { top: 0; left: 7px; width: 2px; height: 16px; }
  .faq-item[open] .faq-icon::after { opacity: 0; }
  .faq-answer { padding: 0 0 20px; color: var(--color-body); font-size: 0.92rem; }
  @media (max-width: 800px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
