const {
  titlePlain = 'Scientific rigor,',
  titleAccent = 'always grounded in human care.',
  subtitle = 'Fertility care is not one-size-fits-all.<br />At <strong>fivclínic:</strong>',
  items = defaultItems,
  note = 'FIVClínic is also clear that vitrified oocytes do not guarantee a future pregnancy, an important distinction that shapes the entire counselling approach from the start.',
} = Astro.props;
---

<section class="section rigor-outer">
  <div class="container">
    <div class="rigor-card">
      <div class="text-center rigor-head">
        <h2>{titlePlain} <span class="accent">{titleAccent}</span></h2>
        <p set:html={subtitle} />
      </div>
      <div class="rigor-grid" style={`--rcols:${items.length}`}>
        {items.map((it) => (
          <div class="rigor-item">
            <span class="rigor-icon" set:html={it.icon} />
            <p>{it.text}</p>
          </div>
        ))}
      </div>
      <p class="rigor-note text-center" set:html={note} />
    </div>
  </div>
</section>

<style>
  .rigor-outer { background: #F5F5F5; }
  .rigor-card {
    background: var(--color-white);
    border-radius: 24px;
    border-top-left-radius: 140px;
    border-bottom-left-radius: 60px;
    padding: clamp(40px, 5vw, 72px) clamp(28px, 5vw, 80px);
  }
  .rigor-head { max-width: 640px; margin: 0 auto 44px; }
  .rigor-head h2 { font-size: clamp(1.6rem, 2.6vw, 2.2rem); font-weight: 500; }
  .rigor-head h2 .accent { color: var(--color-accent); display: block; }
  .rigor-head p { font-size: 0.95rem; color: var(--color-body); }
  .rigor-grid { display: grid; grid-template-columns: repeat(var(--rcols, 4), 1fr); gap: 24px; margin-bottom: 40px; }
  .rigor-item { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .rigor-icon { display: inline-flex; margin-bottom: 14px; }
  .rigor-icon :global(svg) { width: 44px; height: 48px; }
  .rigor-item p { font-size: 0.9rem; color: var(--color-heading); margin: 0; max-width: 26ch; }
  .rigor-note { max-width: 680px; margin: 0 auto; font-size: 1.05rem; color: var(--color-heading); font-weight: 500; }
  @media (max-width: 900px) {
    .rigor-grid { grid-template-columns: 1fr 1fr; }
    .rigor-card { border-top-left-radius: 80px; }
  }
</style>
