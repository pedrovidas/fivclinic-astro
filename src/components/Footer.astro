---
const logo = 'https://fivclinic.es/international-patients/wp-content/uploads/2026/02/Carpeta-1.svg';
const instLogos = 'https://fivclinic.es/international-patients/wp-content/uploads/2026/02/Group-784.png';

const links = [
  { label: 'Contact us', href: '/contact-us/' },
  { label: 'Request expert case review', href: '/fertility-assessment/' },
  { label: 'Privacy policy', href: '/privacy-policy/' },
  { label: 'Legal notice', href: '/legal-notice/' },
  { label: 'Cookies policy', href: '/cookies-policy/' },
];

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/fivclinic/', icon: 'instagram' },
  { label: 'Facebook', href: 'https://www.facebook.com/FIVclinic', icon: 'facebook' },
  { label: 'X', href: 'https://x.com/fivclinic', icon: 'x' },
  { label: 'YouTube', href: 'https://www.youtube.com/watch?v=QGEQuDzcMoo&list=PLRC9GhRkW9GvgznYGNYwe060YJ2Pd7B2z', icon: 'youtube' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src={logo} alt="FIVclínic+ — Barnaclínic+" class="footer-logo" />
      <p class="footer-location">Barcelona · Spain</p>
      <p class="footer-tagline">
        Advanced fertility care for complex cases, supported by the medical
        excellence and clinical standards of Hospital Clínic Barcelona.
      </p>
      <img src={instLogos} alt="barnaclínic+ · Grup Hospital Clínic · Clínic Barcelona" class="footer-inst-logos" />
    </div>

    <div class="footer-col">
      <h3>Contact &amp; Information</h3>
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-socials">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
          {s.icon === 'instagram' && (
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1zm0 3.1a4.9 4.9 0 100 9.8 4.9 4.9 0 000-9.8zm0 8.1a3.2 3.2 0 110-6.4 3.2 3.2 0 010 6.4zm6.2-8.3a1.1 1.1 0 11-2.3 0 1.1 1.1 0 012.3 0z"/></svg>
          )}
          {s.icon === 'facebook' && (
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 12a10 10 0 10-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0022 12z"/></svg>
          )}
          {s.icon === 'x' && (
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.2 2.3h3.3l-7.2 8.2 8.5 11.2h-6.7l-5.2-6.8-6 6.8H1.6l7.7-8.8L1.2 2.3H8l4.7 6.2 5.5-6.2zm-1.2 17.6h1.8L7.1 4.1H5.2l11.8 15.8z"/></svg>
          )}
          {s.icon === 'youtube' && (
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M23 7.5c-.3-1-1-1.8-2-2C19.2 5 12 5 12 5s-7.2 0-9 .5c-1 .2-1.8 1-2 2C.5 9.3.5 12 .5 12s0 2.7.5 4.5c.3 1 1 1.8 2 2C4.8 19 12 19 12 19s7.2 0 9-.5c1-.2 1.8-1 2-2 .5-1.8.5-4.5.5-4.5s0-2.7-.5-4.5zM9.8 15.3V8.7l6 3.3-6 3.3z"/></svg>
          )}
        </a>
      ))}
    </div>
  </div>

  <div class="footer-bottom-wrap">
    <div class="container footer-bottom">
      <p>&copy; {new Date().getFullYear()} Copyright FIVclínic+. All Rights Reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-white);
    color: var(--color-body);
    padding-top: 64px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1.2fr auto;
    gap: 48px;
    padding-bottom: 40px;
  }
  .footer-logo {
    height: 46px;
    width: auto;
    margin-bottom: 16px;
  }
  .footer-location {
    font-size: 0.95rem;
    color: var(--color-body);
    margin-bottom: 16px;
  }
  .footer-tagline {
    font-size: 0.9rem;
    color: var(--color-body);
    max-width: 42ch;
    margin-bottom: 28px;
  }
  .footer-inst-logos {
    height: 48px;
    width: auto;
  }

  .footer-col h3 {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-heading);
    margin-bottom: 18px;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .footer-col a {
    font-size: 0.95rem;
    color: var(--color-accent);
    transition: opacity 0.2s ease;
  }
  .footer-col a:hover {
    opacity: 0.7;
  }

  .footer-socials {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .footer-socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-muted);
    color: var(--color-white);
    transition: background 0.2s ease;
  }
  .footer-socials a:hover {
    background: var(--color-accent);
  }

  .footer-bottom-wrap {
    border-top: 1px solid var(--color-border);
  }
  .footer-bottom {
    padding-block: 24px;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-socials {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
