---
const teamPhoto = 'https://fivclinic.es/international-patients/wp-content/uploads/2026/04/fivclinic-team.png';
---

<section class="team-hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Our team</p>
      <h1 class="hero-title">
        Specialized fertility care, <span class="accent">built on expertise, science, and trust</span>
      </h1>
      <p>
        At <strong>FIVClínic</strong>, we combine the experience of a
        specialized medical team with the clinical environment of
        <strong>Hospital Clínic Barcelona</strong>, one of Europe&rsquo;s
        leading university hospitals.
      </p>
      <p>
        Our approach is simple: to understand each patient&rsquo;s situation in
        depth and provide <strong>clear, evidence-based guidance tailored to
        their needs.</strong>
      </p>
      <p>
        Whether you are seeking a second opinion, exploring treatment options,
        or starting your fertility journey from abroad, our team is here to
        support you with <strong>clinical rigor, transparency, and care.</strong>
      </p>
    </div>
  </div>
  <div class="hero-media">
    <img src={teamPhoto} alt="FIVclínic medical team" loading="eager" />
  </div>
</section>

<style>
  .team-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  .hero-inner {
    display: flex;
    align-items: center;
    padding: clamp(48px, 6vw, 96px) clamp(24px, 4vw, 64px) clamp(48px, 6vw, 96px) 0;
    padding-left: max(24px, calc((100vw - var(--container-width)) / 2));
    max-width: calc(var(--container-width) / 2 + 24px);
    margin-left: auto;
    width: 100%;
  }
  .hero-title {
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 400;
    line-height: 1.12;
    margin-bottom: 0.6em;
  }
  .hero-title .accent {
    color: var(--color-accent);
  }
  .hero-copy p {
    font-size: 0.95rem;
    color: var(--color-body);
  }
  .hero-media {
    position: relative;
    min-height: 440px;
  }
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 900px) {
    .team-hero {
      grid-template-columns: 1fr;
    }
    .hero-inner {
      max-width: 100%;
      padding: 48px 24px;
    }
    .hero-media {
      min-height: 300px;
      order: -1;
    }
  }
</style>
