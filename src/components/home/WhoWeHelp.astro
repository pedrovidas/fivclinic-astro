---
interface Card { title: string; tags: string; cta: string; href: string; icon: string }
interface Props { t?: any }
const { t = {} } = Astro.props;
const iconBase = 'https://fivclinic.es/international-patients/wp-content/uploads/2026/04/';
const defaults: Card[] = [
  { title: 'Complex Fertility Cases', tags: 'Failed IVF · Women over 40 · Genetic factors', cta: 'Explore complex fertility care', href: '/complex-fertility-cases/', icon: iconBase + 'Group-1135.svg' },
  { title: 'Recurrent Pregnancy Loss', tags: 'Understanding why pregnancies don\u2019t continue', cta: 'Explore RPL program', href: '/rpl/', icon: iconBase + 'Group-1134.svg' },
  { title: 'IVF with Donor Eggs', tags: 'Personalized donor programs with strict criteria', cta: 'Explore egg donation', href: '/ivf-with-donor-eggs/', icon: iconBase + 'Group-1133.svg' },
  { title: 'Fertility Preservation', tags: 'Plan your future fertility with expert guidance', cta: 'Explore fertility preservation', href: '/fertility-preservation-in-barcelona/', icon: iconBase + 'Group-1132.svg' },
  { title: 'Single Women & Female Couples', tags: 'Safe, respectful, and evidence-based fertility care', cta: 'Explore this pathway', href: '/fertility-for-single-women-female-couples/', icon: iconBase + 'Group-1136.svg' },
];
const cards: Card[] = t.cards ?? defaults;
const eyebrow = t.eyebrow ?? 'Who we help';
const titlePlain = t.titlePlain ?? 'Find the right path';
const titleAccent = t.titleAccent ?? 'for your situation';
const lead = t.lead ?? 'Every fertility journey is different. We help patients from around the world across a wide range of situations:';
---

<section class="section who-we-help">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{titlePlain} <span class="accent">{titleAccent}</span></h2>
      <p class="section-lead">{lead}</p>
    </div>

    <div class="cards-grid">
      {cards.map((card) => (
        <a href={card.href} class="care-card">
          <div class="care-card-icon">
            <img src={card.icon} alt="" width="48" height="48" loading="lazy" />
          </div>
          <div class="care-card-body">
            <h3>{card.title}</h3>
            <p class="care-card-tags">{card.tags}</p>
            <span class="care-card-cta">{card.cta}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Cabecera pegada al borde izquierdo del contenedor, compacta (como el original) */
  .section-head {
    margin-bottom: 32px;
  }
  .section-head .eyebrow {
    margin-bottom: 6px;
  }
  .section-head h2 {
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
    font-weight: 600;
    margin-bottom: 10px;
  }
  .who-we-help h2 .accent { color: var(--color-accent); }
  .section-lead {
    color: var(--color-heading);
    font-size: 0.95rem;
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }

  .care-card {
    display: block;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-align: center;
    padding: 26px 16px 24px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .care-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  .care-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    margin: 0 auto 22px;
    border-radius: 50%;
    background: var(--color-surface);
  }
  .care-card-icon img {
    width: 34px;
    height: 34px;
  }

  .care-card-body h3 {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-accent);
    margin-bottom: 12px;
  }
  .care-card-tags {
    font-size: 0.9rem;
    color: var(--color-heading);
    line-height: 1.45;
    margin: 0 0 16px;
  }
  .care-card-cta {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1000px) {
    .cards-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    .cards-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
