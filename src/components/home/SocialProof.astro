<style>
  .social-path {
    background: var(--color-accent-pale);
    border-radius: 40px 0 0 220px;
    overflow: hidden;
    position: relative;
  }
  .path-deco {
    position: absolute;
    top: 28px;
    left: 40px;
    width: 54px;
    height: 54px;
    opacity: 0.9;
  }
  .path-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(32px, 4vw, 64px);
  }
  .path-copy { max-width: 560px; }
  .path-title { font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 500; margin-bottom: 8px; line-height: 1.2; }
  .path-title .accent { color: var(--color-accent); display: block; }
  .path-lead { font-size: clamp(1.05rem, 1.6vw, 1.35rem); font-weight: 400; margin-bottom: 26px; }
  .path-lead.accent { color: var(--color-accent); }
  .path-cta { display: block; width: 100%; max-width: 560px; text-align: center; padding-block: 1.15em; }
  .path-note { font-size: 0.85rem; color: var(--color-heading); margin-top: 14px; text-align: center; max-width: 560px; }


  .fiv-gallery-wrap {
    width: 100%;
    font-family: 'Bryan Pro', sans-serif;
    --transition: 0.35s ease;
  }

  .fiv-gallery-grid {
    display: grid;
    grid-template-columns: 216px 393px;
    grid-template-rows: 204px 204px;
    gap: 7px;
    width: fit-content;
  }

  .fiv-card {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  .fiv-card.fiv-main {
    grid-column: 2;
    grid-row: 1 / 3;
    height: 415px;
  }

  .fiv-card img.fiv-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1) brightness(1);
    transition: filter var(--transition), transform var(--transition);
  }

  .fiv-card-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transform: translateY(100%);
    transition: transform var(--transition);
    border-radius: 0 0 14px 14px;
  }

  .fiv-card-caption p {
    font-family: 'Bryan Pro', sans-serif;
    font-size: 12px;
    line-height: 1.6;
    color: #333;
    margin: 0;
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .fiv-brand-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .fiv-caption-text { flex: 1; }
  .fiv-heart { color: #e05c5c; }

  .fiv-card:hover img.fiv-photo {
    filter: saturate(1.4) brightness(1.05) contrast(1.05);
    transform: scale(1.03);
  }

  .fiv-card:hover .fiv-card-caption {
    transform: translateY(0);
  }

  /* ── CARRUSEL ── */
  .fiv-gallery-carousel {
    display: none;
    position: relative;
    width: 100%;
  }

  .fiv-carousel-track-wrap {
    overflow: hidden;
    border-radius: 14px;
    width: 100%;
  }

  .fiv-carousel-track {
    display: flex;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  /* Cada slide ocupa exactamente el ancho del wrapper */
  .fiv-carousel-track .fiv-card {
    flex: 0 0 100%;
    width: 100%;
    height: 346px;
  }

  .fiv-carousel-dots {
    display: flex;
    justify-content: center;
    gap: 7px;
    margin-top: 14px;
  }

  .fiv-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #e8c5c5;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.25s, transform 0.25s;
  }

  .fiv-dot.active {
    background: #e05c5c;
    transform: scale(1.2);
  }

  @media (max-width: 1024px) {
    .fiv-gallery-grid { display: none; }
    .fiv-gallery-carousel { display: block; }

    .fiv-card.touched img.fiv-photo {
      filter: saturate(1.4) brightness(1.05) contrast(1.05);
    }
    .fiv-card.touched .fiv-card-caption {
      transform: translateY(0);
    }
  }


  /* En el original el wrap vive en su propia columna; aquí debe medir su contenido */
  .fiv-gallery-wrap { width: auto; }

  @media (max-width: 1024px) {
    .path-grid { grid-template-columns: 1fr; }
    .fiv-gallery-wrap { width: 100%; }
    /* El icono decorativo no debe pisar el título en pantallas pequeñas */
    .path-deco { display: none; }
    /* Radio suave para que el contenido no parezca cortado */
    .social-path { border-radius: 28px 0 0 28px; }
  }
</style>

<script is:inline>

(function() {
  var wrap   = document.getElementById('fivWrap');
  var track  = document.getElementById('fivTrack');
  var dotsEl = document.getElementById('fivDots');
  if (!track || !wrap) return;

  var current = 0;
  var slides  = track.querySelectorAll('.fiv-card');
  var dots    = dotsEl ? dotsEl.querySelectorAll('.fiv-dot') : [];
  var total   = slides.length;
  var startX  = 0;

  function getSlideWidth() {
    // Siempre el ancho real del wrapper en ese momento
    return wrap.offsetWidth;
  }

  function goTo(idx) {
    current = (idx + total) % total;
    var offset = current * getSlideWidth();
    track.style.transform = 'translateX(-' + offset + 'px)';
    dots.forEach(function(d, i) { d.classList.toggle('active', i === current); });
  }

  dots.forEach(function(btn) {
    btn.addEventListener('click', function() { goTo(+btn.dataset.index); });
  });

  track.addEventListener('touchstart', function(e) {
    startX = e.touches[0].clientX;
  }, { passive: true });

  track.addEventListener('touchend', function(e) {
    var diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
  });

  // Recalcular posición si cambia el tamaño de ventana
  window.addEventListener('resize', function() { goTo(current); });

  // Touch hover
  slides.forEach(function(card) {
    card.addEventListener('touchstart', function() {
      slides.forEach(function(c) { if (c !== card) c.classList.remove('touched'); });
      card.classList.toggle('touched');
    }, { passive: true });
  });
})();

</script>
