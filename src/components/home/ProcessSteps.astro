---
interface Step { title: string; text: string; icon?: string; }
interface Props {
  steps?: Step[];
  titlePlain?: string;
  titleAccent?: string;
  surface?: boolean;
}
const {
  titlePlain = 'A step-by-step process',
  titleAccent = 'designed around you',
  surface = true,
  steps = [
    {
      icon: 'https://fivclinic.es/international-patients/wp-content/uploads/2026/04/Background-14.svg',
      title: 'Online consultation',
      text: 'Discuss your case with a fertility specialist from anywhere in the world, by video call.',
    },
    {
      icon: 'https://fivclinic.es/international-patients/wp-content/uploads/2026/04/Background-15.svg',
      title: 'Personalized plan',
      text: 'Receive clear medical recommendations tailored to your specific situation and history.',
    },
    {
      icon: 'https://fivclinic.es/international-patients/wp-content/uploads/2026/04/Background-16.svg',
      title: 'Plan your visit',
      text: 'We help you organize timing, travel logistics, and all documentation needed.',
    },
    {
      icon: 'https://fivclinic.es/international-patients/wp-content/uploads/2026/04/Background-17.svg',
      title: 'Treatment & follow-up',
      text: 'Care in Barcelona, then ongoing support and coordination after you return home.',
    },
  ],
} = Astro.props;
---

<section class:list={['section', 'process', { 'section-surface': surface }]}>
  <div class="container">
    <div class="section-head text-center">
      <p class="eyebrow">The process</p>
      <h2>{titlePlain}<br /><span class="accent">{titleAccent}</span></h2>
    </div>

    <ol class="process-list">
      {steps.map((step, i) => (
        <li class="process-step">
          {step.icon ? (
            <img src={step.icon} alt="" class="process-icon" width="52" height="52" loading="lazy" />
          ) : (
            <span class="process-index">{String(i + 1).padStart(2, '0')}</span>
          )}
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .process-step {
    text-align: center;
    padding: 0 12px;
  }
  .process-icon {
    display: block;
    width: 36px;
    height: 36px;
    margin: 0 auto 20px;
  }
  .process-index {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    margin: 0 auto 18px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .process-step h3 {
    font-size: 1.05rem;
    margin-bottom: 8px;
  }
  .process-step p {
    font-size: 0.9rem;
    margin: 0;
    color: var(--color-body);
  }
  @media (max-width: 900px) {
    .process-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .process-list {
      grid-template-columns: 1fr;
    }
  }
</style>
