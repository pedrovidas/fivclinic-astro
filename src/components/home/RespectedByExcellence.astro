---
const uploads = 'https://fivclinic.es/international-patients/wp-content/uploads/';

// Composición equipo + recepción (misma imagen collage usada en el original)
const teamCollage = uploads + '2026/02/Group-763.png';

const instStrip = uploads + '2026/04/fivclinic-barnaclinic-1.png';   // Clínic Barcelona · Universitat
const sefLogo   = uploads + '2026/04/sociedad-espanola-de-fertilidad-1.png';

const stats = [
  { value: 100, suffix: '+',  label: 'years of clinical, research, and teaching activity' },
  { value: 750, suffix: '+',  label: 'active beds' },
  { value: 642, suffix: 'K+', label: 'outpatient consultations' },
  { value: 31,  suffix: 'K+', label: 'operations performed' },
];
---

<section class="section respected">
  <div class="container respected-grid">
    <div class="respected-copy">
      <p class="eyebrow">Clinical experience</p>
      <h2>Respected by<br /><span class="accent">institutional excellence</span></h2>
      <p class="section-lead">
        Over 30 years of reproductive medicine, supported by the
        infrastructure and clinical standards of one of Europe&rsquo;s great
        university hospitals.
      </p>

      <div class="stats-box">
        {stats.map((s, i) => (
          <div class:list={['stat-cell', { 'has-divider': i > 0 }]}>
            <p class="stat-number">
              <span class="js-counter" data-to={s.value}>0</span><sup>{s.suffix}</sup>
            </p>
            <p class="stat-label">{s.label}</p>
          </div>
        ))}
      </div>

      <div class="inst-logos">
        <img src={instStrip} alt="Clínic Barcelona · Universitat de Barcelona · barnaclínic+" />
      </div>

      <p class="members-label">Members:</p>
      <div class="members">
        <img src={sefLogo} alt="Sociedad Española de Fertilidad · ESHRE-Certified Senior Clinical Embryologists" class="sef-logo" />
      </div>
    </div>

    <div class="respected-media">
      <svg class="rings rings-top" viewBox="0 0 200 200" aria-hidden="true">
        <circle cx="100" cy="100" r="88" fill="none" stroke="var(--color-accent-light)" stroke-width="14" opacity="0.55"/>
        <circle cx="100" cy="100" r="52" fill="none" stroke="var(--color-accent-light)" stroke-width="14" opacity="0.55"/>
      </svg>
      <svg class="rings rings-bottom" viewBox="0 0 200 200" aria-hidden="true">
        <circle cx="100" cy="100" r="88" fill="none" stroke="var(--color-accent-light)" stroke-width="14" opacity="0.55"/>
        <circle cx="100" cy="100" r="52" fill="none" stroke="var(--color-accent-light)" stroke-width="14" opacity="0.55"/>
      </svg>
      <img src={teamCollage} alt="FIVclínic medical team" class="team-photo" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .respected-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .respected-copy h2 {
    font-size: clamp(1.7rem, 2.8vw, 2.4rem);
    font-weight: 500;
    margin-bottom: 14px;
    line-height: 1.2;
  }
  .respected-copy h2 .accent { color: var(--color-accent); }
  .section-lead {
    color: var(--color-body);
    max-width: 52ch;
    margin-bottom: 32px;
  }

  .stats-box {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    margin-bottom: 32px;
  }
  .stat-cell { padding: 20px 16px; }
  .stat-cell.has-divider { border-left: 1px solid var(--color-border); }
  .stat-number {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    margin: 0 0 8px;
    white-space: nowrap;
  }
  .stat-number sup { font-size: 0.6em; }
  .stat-label {
    font-size: 0.72rem;
    color: var(--color-body);
    margin: 0;
    line-height: 1.4;
  }

  .inst-logos {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .inst-logos img { max-height: 40px; width: auto; }

  .members-label { font-size: 0.8rem; color: var(--color-muted); margin: 0 0 10px; }
  .members { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .sef-logo { max-height: 48px; width: auto; }

  .respected-media { position: relative; }
  .team-photo { position: relative; width: 100%; z-index: 1; }
  .rings { position: absolute; z-index: 0; }
  .rings-top { top: -30px; left: 34%; width: 180px; }
  .rings-bottom { bottom: -36px; right: -20px; width: 210px; }

  @media (max-width: 900px) {
    .respected-grid { grid-template-columns: 1fr; }
    .stats-box { grid-template-columns: 1fr 1fr; }
    .stat-cell:nth-child(3) { border-left: none; border-top: 1px solid var(--color-border); }
    .stat-cell:nth-child(4) { border-top: 1px solid var(--color-border); }
  }
</style>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('.respected .js-counter');
  const animate = (el: HTMLElement) => {
    const to = Number(el.dataset.to ?? '0');
    if (prefersReduced) { el.textContent = String(to); return; }
    const dur = 1500, start = performance.now();
    const step = (now: number) => {
      const p = Math.min((now - start) / dur, 1);
      el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) { animate(e.target as HTMLElement); obs.unobserve(e.target); }
    });
  }, { threshold: 0.4 });
  els.forEach((el) => obs.observe(el));
</script>
