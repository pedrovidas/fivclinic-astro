---
interface Props { t?: any }
const { t = {} } = Astro.props;
const eyebrow = t.eyebrow ?? 'Advanced fertility and IVF clinic in Barcelona';
const titleAccent = t.titleAccent ?? 'World-class fertility care';
const titleTail = t.titleTail ?? ' in a leading medical destination in Europe';
const lead = t.lead ?? 'Barcelona is not only a premier travel destination, it is a place patients from around the world choose for high-quality, specialized medical care.';
const paragraphs = t.paragraphs ?? [
  'At <strong>FIVClínic</strong>, we provide personalized fertility treatment and expert guidance for complex cases, supported by the clinical environment of <strong>Hospital Clínic Barcelona</strong>.',
  'Whether you are exploring treatment options, seeking a second opinion, or planning your fertility journey from abroad, our team is here to guide you with clarity, care, and expertise.',
];
const note = t.note ?? 'FIVClínic is the assisted reproduction department of barnaclínic+, backed by <strong>Hospital Clínic Barcelona</strong> — an internationally ranked, tier-1 university hospital group.';
const heroImg = t.image ?? 'https://fivclinic.es/international-patients/wp-content/uploads/2026/06/motherhood-at-FIVCLINIC.png';
const instLogos = t.instLogos ?? 'https://fivclinic.es/international-patients/wp-content/uploads/2026/04/universitat-barcelona.png';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="hero-title"><span class="accent">{titleAccent}</span>{titleTail}</h1>
      <p class="hero-lead">{lead}</p>
      {paragraphs.map((par: string) => <p set:html={par} />)}
      <p class="hero-note" set:html={note} />
      <img src={instLogos} alt="Hospital Clínic Barcelona · IDIBAPS · Universitat de Barcelona" class="hero-inst-logos" loading="eager" />
    </div>
    <div class="hero-media">
      <img src={heroImg} alt="FIVclínic — patient care" class="hero-img" loading="eager" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 5vw, 72px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: start;
  }
  .hero-title {
    font-size: clamp(2.2rem, 3.6vw, 3.3rem);
    font-weight: 400;
    line-height: 1.12;
    margin-bottom: 0.6em;
  }
  .hero-title .accent {
    color: var(--color-accent);
  }
  .hero-lead {
    font-size: 1.05rem;
    color: var(--color-body);
  }
  .hero-note {
    font-size: 0.9rem;
    color: var(--color-body);
    margin-bottom: 1.6em;
  }
  .hero-inst-logos {
    max-width: 420px;
    width: 100%;
    height: auto;
    margin-top: 8px;
  }
  .hero-img {
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    border-radius: 200px 200px 12px 12px;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-media {
      order: -1;
    }
  }
</style>
