---
interface Props {
  ratio?: string; // e.g. "16 / 9", "1 / 1"
  label?: string;
  sourceHint?: string; // filename/URL hint for swapping later
  class?: string;
}
const { ratio = '4 / 3', label = 'Image', sourceHint, class: className = '' } = Astro.props;
---

<!-- TODO reemplazar: ${sourceHint ?? 'ver wp-content/uploads del sitio original'} -->
<div class:list={['img-placeholder', className]} style={{ aspectRatio: ratio }}>
  <span>{label}</span>
</div>

<style>
  .img-placeholder {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: repeating-linear-gradient(
      135deg,
      var(--color-surface),
      var(--color-surface) 10px,
      #eeeae5 10px,
      #eeeae5 20px
    );
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    font-size: 0.78rem;
    text-align: center;
    padding: 12px;
    overflow: hidden;
  }
</style>
