---
interface Stat {
  value: number;
  suffix: string;
  label: string;
  sublabel?: string;
  subItalic?: string;
}
interface Props {
  stats: Stat[];
  variant?: 'light' | 'dark';
}
const { stats, variant = 'light' } = Astro.props;
---

<div class={`stats-wrap stats-bar--${variant}`} data-stats-carousel>
  <div class="stats-bar" data-stats-track>
    {stats.map((s) => (
      <div class="stat">
        <p class="stat-number">
          <span class="js-counter" data-to={s.value}>0</span><sup class="stat-suffix">{s.suffix}</sup>
        </p>
        <p class="stat-label">{s.label}</p>
        {s.sublabel && <p class="stat-sublabel">{s.sublabel}</p>}
        {s.subItalic && <p class="stat-subitalic">{s.subItalic}</p>}
      </div>
    ))}
  </div>

  <div class="stats-dots" data-stats-dots aria-label="Pagination">
    {stats.map((_, i) => (
      <button class:list={['stats-dot', { active: i === 0 }]} data-index={i} aria-label={`Slide ${i + 1}`}></button>
    ))}
  </div>
</div>

<style>
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 32px;
    text-align: left;
  }
  .stat-number {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.6vw, 3rem);
    color: var(--color-accent);
    font-weight: 600;
    margin: 0;
    line-height: 1;
  }
  .stat-suffix {
    font-size: 0.5em;
    vertical-align: super;
    margin-left: 2px;
  }
  .stat-label {
    margin: 4px 0 12px;
    font-size: 1rem;
    color: var(--color-accent);
    font-weight: 600;
  }
  .stat-sublabel {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-body);
    max-width: 26ch;
  }
  .stat-subitalic {
    margin: 6px 0 0;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-body);
  }
  .stats-bar--dark .stat-number { color: var(--color-white); }
  .stats-bar--dark .stat-label { color: #e8e2dc; }
  .stats-bar--dark .stat-sublabel { color: #b3b3b3; }

  /* Dots: solo visibles en modo carrusel */
  .stats-dots { display: none; }

  /* ===== Carrusel en móvil y tablet ===== */
  @media (max-width: 1024px) {
    .stats-bar {
      display: flex;
      gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .stats-bar::-webkit-scrollbar { display: none; }
    .stat {
      flex: 0 0 100%;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding-inline: 24px;
    }
    .stat .stat-sublabel { max-width: 34ch; }

    .stats-dots {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-top: 22px;
    }
    .stats-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      border: none;
      padding: 0;
      background: var(--color-accent-light);
      cursor: pointer;
      transition: background 0.2s ease, transform 0.2s ease;
    }
    .stats-dot.active {
      background: var(--color-accent);
      transform: scale(1.25);
    }
  }
</style>

<script>
  // Animación de conteo (respeta prefers-reduced-motion)
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('.js-counter');

  const animate = (el: HTMLElement) => {
    const to = Number(el.dataset.to ?? '0');
    if (prefersReduced) {
      el.textContent = String(to);
      return;
    }
    const duration = 1400;
    const start = performance.now();
    const step = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = String(Math.round(to * eased));
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animate(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.4 }
  );
  counters.forEach((c) => observer.observe(c));

  // Carrusel con dots (móvil/tablet): scroll-snap nativo + sincronización
  document.querySelectorAll<HTMLElement>('[data-stats-carousel]').forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>('[data-stats-track]');
    const dots = wrap.querySelectorAll<HTMLButtonElement>('.stats-dot');
    if (!track || !dots.length) return;

    const setActive = (idx: number) => {
      dots.forEach((d, i) => d.classList.toggle('active', i === idx));
    };

    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const slideW = track.clientWidth;
        if (!slideW) return;
        const idx = Math.round(track.scrollLeft / slideW);
        setActive(Math.max(0, Math.min(idx, dots.length - 1)));
      });
    }, { passive: true });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.dataset.index ?? '0');
        track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' });
      });
    });
  });
</script>
