---
const whatsappNumber = '34660116080';
const address = 'Carrer de Casanova, 153, Eixample, 08036 Barcelona';
const mapEmbed = `https://maps.google.com/maps?q=${encodeURIComponent('Carrer de Casanova 153, 08036 Barcelona')}&z=15&output=embed`;

const whyChoose = [
  '30+ years of specialized experience in reproductive medicine',
  'First informative consultation free of charge',
  'Personalized care throughout the entire process',
];
---

<aside class="contact-sidebar">
  <div class="side-card">
    <h3>Talk to us <span class="accent">on Whatsapp</span></h3>
    <a href={`https://wa.me/${whatsappNumber}`} class="wa-btn" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 32 32" width="20" height="20" fill="currentColor" aria-hidden="true">
        <path d="M16 .5C7.4.5.5 7.4.5 16c0 2.8.7 5.4 2 7.8L.5 31.5l7.9-2c2.3 1.3 4.9 1.9 7.6 1.9 8.6 0 15.5-6.9 15.5-15.5S24.6.5 16 .5zm0 28.3c-2.4 0-4.8-.6-6.8-1.9l-.5-.3-4.7 1.2 1.2-4.6-.3-.5A12.8 12.8 0 013.2 16C3.2 8.9 8.9 3.2 16 3.2S28.8 8.9 28.8 16 23.1 28.8 16 28.8zm7-9.6c-.4-.2-2.3-1.1-2.6-1.3-.4-.1-.6-.2-.9.2-.3.4-1 1.3-1.2 1.5-.2.2-.4.3-.8.1-.4-.2-1.6-.6-3.1-1.9-1.1-1-1.9-2.3-2.1-2.6-.2-.4 0-.6.2-.7.2-.2.4-.4.6-.7.2-.2.2-.4.4-.6.1-.3 0-.5 0-.7-.1-.2-.9-2.1-1.2-2.9-.3-.8-.6-.7-.9-.7h-.8c-.2 0-.6.1-1 .5-.3.4-1.3 1.3-1.3 3.1s1.3 3.6 1.5 3.9c.2.2 2.6 4 6.3 5.6.9.4 1.6.6 2.1.8.9.3 1.7.2 2.3.1.7-.1 2.3-.9 2.6-1.8.3-.9.3-1.7.2-1.8-.1-.2-.3-.3-.7-.5z"/>
      </svg>
      Chat on WhatsApp
    </a>
  </div>

  <div class="side-card">
    <h3>Our location in <span class="accent">Barcelona</span></h3>
    <p>
      FIVClínic is part of the clinical environment of Hospital Clínic
      Barcelona, located in the center of Barcelona.
    </p>
    <p class="address"><strong>Address:</strong><br />{address}</p>
    <div class="map-wrap">
      <iframe
        src={mapEmbed}
        title="FIVclínic location in Barcelona"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <p class="map-note">
      Barcelona offers excellent international connectivity, making it easy to
      travel for treatment from most major cities worldwide.
    </p>
  </div>

  <div class="side-card">
    <h3>Why choose <span class="accent">FIVClínic?</span></h3>
    <ul class="why-list">
      {whyChoose.map((item) => (
        <li>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="11" stroke="var(--color-accent)" stroke-width="1.5"/>
            <path d="M7 12.5l3 3 7-7" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .side-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 28px;
  }
  .side-card h3 {
    font-size: 1.3rem;
    font-weight: 400;
    margin-bottom: 16px;
  }
  .side-card h3 .accent {
    color: var(--color-accent);
  }
  .side-card p {
    font-size: 0.92rem;
    color: var(--color-body);
  }
  .address {
    margin-top: 12px;
  }
  .wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25d366;
    color: #fff;
    padding: 0.85em 1.6em;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 0.2s ease;
  }
  .wa-btn:hover {
    background: #1fb855;
  }
  .map-wrap {
    margin: 16px 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }
  .map-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .map-note {
    font-size: 0.85rem;
    color: var(--color-body);
  }
  .why-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .why-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.92rem;
    color: var(--color-heading);
  }
  .why-list svg {
    flex-shrink: 0;
    margin-top: 2px;
  }
</style>
