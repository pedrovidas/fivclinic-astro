---
const teamPhoto = 'https://fivclinic.es/international-patients/wp-content/uploads/2026/04/our-team.png';
const instLogos = 'https://fivclinic.es/international-patients/wp-content/uploads/2026/04/universitat-barcelona.png';
---

<section class="contact-hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Contact our team</p>
      <h1 class="hero-title">
        Speak with our <span class="accent">fertility experts</span>
      </h1>
      <p class="hero-lead">
        Our specialized team reviews every request carefully and responds
        promptly — typically within 24 hours. You&rsquo;ll receive clear,
        personalized guidance without unnecessary delays.
      </p>
      <p class="hero-note">
        FIVClínic is part of barnaclínic+, the private medicine programme of
        Hospital Clínic Barcelona, one of Europe&rsquo;s most respected
        university hospitals.
      </p>
      <img src={instLogos} alt="Clínic Barcelona · IDIBAPS · Universitat de Barcelona" class="hero-inst-logos" />
    </div>
  </div>
  <div class="hero-media">
    <img src={teamPhoto} alt="FIVclínic fertility team" loading="eager" />
  </div>
</section>

<style>
  .contact-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  .hero-inner {
    display: flex;
    align-items: center;
    padding: clamp(48px, 6vw, 96px) clamp(24px, 4vw, 64px) clamp(48px, 6vw, 96px) 0;
    margin-left: auto;
    max-width: calc(var(--container-width) / 2 + max(24px, (100vw - var(--container-width)) / 2));
    width: 100%;
  }
  .hero-inner {
    padding-left: max(24px, calc((100vw - var(--container-width)) / 2));
  }
  .hero-title {
    font-size: clamp(2.3rem, 4vw, 3.4rem);
    font-weight: 400;
    line-height: 1.12;
    margin-bottom: 0.5em;
  }
  .hero-title .accent {
    color: var(--color-accent);
  }
  .hero-lead {
    font-size: 1.02rem;
    color: var(--color-body);
  }
  .hero-note {
    font-size: 0.85rem;
    color: var(--color-accent);
    margin: 1.4em 0;
  }
  .hero-inst-logos {
    max-width: 400px;
    width: 100%;
    height: auto;
  }
  .hero-media {
    position: relative;
    min-height: 420px;
  }
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .contact-hero {
      grid-template-columns: 1fr;
    }
    .hero-inner {
      max-width: 100%;
      padding: 48px 24px;
    }
    .hero-media {
      min-height: 320px;
      order: -1;
    }
  }
</style>
